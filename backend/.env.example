# ─────────────────────────────────────────────────────────
#  Virtual Edge – Backend Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── AI / OCR ─────────────────────────────────────────────
# Google AI Studio key (Gemini 1.5-pro / flash)
# Get one free at: https://aistudio.google.com/app/apikey
GOOGLE_AI_STUDIO_KEY=

# OpenAI fallback (optional)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq AI (primary, fast inference with free tier)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Cloud Vision (optional, requires service account JSON)
GOOGLE_APPLICATION_CREDENTIALS=

# ── Auth ──────────────────────────────────────────────────
# CHANGE THIS to a long random string in production.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-in-production

# JWT token expiry in minutes (default 1440 = 24 hours)
TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────
# SQLite (default, no setup needed — used when DATABASE_URL is unset)
# DATABASE_URL=sqlite:///./virtualedge.db

# PostgreSQL (recommended for production on Render / Railway)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql://ve_user:strongpassword@localhost:5432/virtualedge

# ── Web Push (VAPID) ──────────────────────────────────────
# Contact email for VAPID claims (shown to browser push services)
VAPID_EMAIL=admin@your-domain.com

# ── Server ────────────────────────────────────────────────
# Port (Render/Railway inject PORT automatically)
PORT=8000

# Allowed CORS origins (comma-separated, or * for open access)
# Example: https://your-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=*

# ── Monitoring ────────────────────────────────────────────
# Minimum predictions before monitoring alerts fire
MONITOR_MIN_SAMPLE=50

# Alert threshold: if win-rate drops below this %, flag in monitoring report
MONITOR_WIN_RATE_ALERT=45
